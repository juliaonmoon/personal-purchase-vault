# Supabase (Postgres + Auth + private Storage) — from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Receipt/document extraction (Claude vision) — see src/lib/extraction
ANTHROPIC_API_KEY=
ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-5

# Transactional email (reminders) — Resend
RESEND_API_KEY=
REMINDER_EMAIL_FROM="Personal Purchase Vault <reminders@yourdomain.com>"

# Protects the reminder cron route from being called by anyone but Vercel Cron
CRON_SECRET=

# Base URL used to build links inside reminder emails
NEXT_PUBLIC_APP_URL=http://localhost:3000
